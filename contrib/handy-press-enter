#!/usr/bin/env python3
"""Handy external paste script: submit only when you asked for it.

Handy runs this as `handy-press-enter "<text>"` when the paste method is
`external_script`. In that mode Handy does NOT paste anything itself, so this
script owns the whole output step.

Behaviour mirrors Wispr Flow's "press enter" command, which is conditional --
unlike Handy's own Auto Submit, which fires after every single paste:

    "run the tests press enter"  ->  pastes "run the tests", presses Return
    "run the tests"              ->  pastes "run the tests", presses nothing
    "press enter"                ->  pastes nothing, presses Return

Handy discards this script's stdout and stderr, so failures are invisible.
Everything is logged to ~/Library/Logs/handy-press-enter.log instead.

Environment knobs:
    HANDY_SUBMIT_DELAY     seconds between paste and Return (default 0.25)
    HANDY_SUBMIT_SLOP      tolerate up to N stray words after the phrase
                           (default 0 = strict, like Wispr Flow)
    HANDY_RESTORE_CLIPBOARD=1  put the previous clipboard back afterwards
"""

import os
import re
import subprocess
import sys
import time
from datetime import datetime

LOG = os.path.expanduser("~/Library/Logs/handy-press-enter.log")
SUBMIT_DELAY = float(os.environ.get("HANDY_SUBMIT_DELAY", "0.25"))
RESTORE_CLIPBOARD = os.environ.get("HANDY_RESTORE_CLIPBOARD") == "1"

try:
    SLOP = max(0, int(os.environ.get("HANDY_SUBMIT_SLOP", "0")))
except ValueError:
    SLOP = 0


def _build_re(slop):
    """Wispr Flow's end-anchored phrase match, widened two ways.

    Group 1 is the sentence punctuation immediately before the phrase, kept so
    that "...the tests. Press enter." still ends in a full stop. Punctuation
    *after* the phrase is dropped rather than reattached -- reattaching it is
    what turns "deploy it, hit enter!" into "deploy it,!".

    `slop` allows N stray words after the phrase. Wispr anchors hard to the end
    of the utterance, so a second voice in the room landing one word after you
    say "press enter" silently kills the match. Slop buys tolerance for that at
    the cost of false submits ("press enter to continue" would fire), so it is
    off by default.
    """
    tail = r"(?:\s+[\w']+)*" if slop is None else r"(?:\s+[\w']+){0,%d}" % slop
    return re.compile(
        r"([.!?;])?[\s]*\b(?:press|hit)\s+(?:enter|return)\b"
        r"[\s.!?,;:-]*" + tail + r"[\s.!?,;:-]*\Z",
        re.IGNORECASE,
    )


SUBMIT_RE = _build_re(SLOP)


def log(msg):
    try:
        with open(LOG, "a") as fh:
            fh.write("%s  %s\n" % (datetime.now().isoformat(timespec="seconds"), msg))
    except OSError:
        pass


def split_submit(text):
    """Return (text_to_paste, should_press_return)."""
    m = SUBMIT_RE.search(text)
    if not m:
        return text, False
    out = text[: m.start()].rstrip() + (m.group(1) or "")
    # Nothing but stray punctuation left means the phrase was the whole
    # utterance -- submit an empty line rather than a lone full stop.
    if re.fullmatch(r"[\s.!?,;:-]*", out):
        out = ""
    return out, True


def osa(script):
    subprocess.run(
        ["osascript", "-e", script],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def main():
    argv = sys.argv[1:]
    dry = "--dry-run" in argv
    args = [a for a in argv if a != "--dry-run"]
    text = args[0] if args else ""

    out, submit = split_submit(text)
    log("in=%r -> paste=%r submit=%s%s" % (text, out, submit, " [dry]" if dry else ""))

    if dry:
        print("paste: %r" % out)
        print("submit: %s" % submit)
        return 0

    saved = None
    if RESTORE_CLIPBOARD:
        saved = subprocess.run(["pbpaste"], capture_output=True, check=False).stdout

    if out:
        subprocess.run(["pbcopy"], input=out.encode("utf-8"), check=False)
        osa('tell application "System Events" to keystroke "v" using command down')

    if submit:
        # Let the paste land before Return, or the app submits an empty field.
        time.sleep(SUBMIT_DELAY)
        osa('tell application "System Events" to key code 36')

    if saved is not None:
        time.sleep(0.2)
        subprocess.run(["pbcopy"], input=saved, check=False)

    return 0


if __name__ == "__main__":
    sys.exit(main())
